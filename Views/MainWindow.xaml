<Window x:Class="DoomDepthsRunewords.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DoomDepths - Runeword helper"
    Width="1200"
    Height="700"
    Background="#372829">
    <Grid Margin="20">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Header="Alla runor" Margin="5" Foreground="White">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding AllRunes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.AddRuneCommand,
                                RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Width="90"
                                Height="90"
                                Margin="5">
                                <StackPanel>
                                    <Image Source="{Binding ImagePath}" Width="45" Height="45"/>
                                    <TextBlock Text="{Binding Name}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>

        <GroupBox Grid.Column="1" Header="Mina runor" Margin="5" Foreground="White" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0" Background="#372829" ItemsSource="{Binding OwnedRunes}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="5"
                                Padding="8"
                                BorderThickness="1"
                                BorderBrush="Gray"
                                Background="#372829">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Source="{Binding Rune.ImagePath}"
                                        Width="45"
                                        Height="45"/>

                                    <TextBlock Grid.Column="1"
                                        Text="{Binding Rune.Name}"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Foreground="White"/>

                                    <TextBlock Grid.Column="2"
                                        Text="{Binding Amount}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        FontSize="16"
                                        Foreground="White"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="1"
                    Content="Clear"
                    Command="{Binding ClearInventoryCommand}"
                    Height="40"
                    Margin="5"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Column="2" Header="Runewords du kan skapa" Margin="5" Foreground="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding AvailableRunewords}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="5"
                                Padding="12"
                                BorderBrush="Gray"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="White"/>

                                    <ItemsControl ItemsSource="{Binding Runes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="3">
                                                    <Image Source="{Binding ImagePath}"
                                                        Width="35"
                                                        Height="35"/>
                                                    <TextBlock Text="{Binding Name}"
                                                        FontSize="11"
                                                        HorizontalAlignment="Center"
                                                        Foreground="White"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding Effects}" Foreground="White" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</Window>